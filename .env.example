# Scan/view analytics → public.pamphlet_events. Use the dedicated insert-only role
# via the Supabase transaction pooler (port 6543), never the postgres superuser.
DATABASE_URL=postgresql://pamphlet_writer.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Public URL of the deployed pamphlet, used for metadata/OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
